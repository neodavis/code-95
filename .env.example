# Docker Compose profiles:
# storage=db+minio only;
# main=storage+api+frontend;
# monitoring=observability+sonar
COMPOSE_PROFILES=main,monitoring

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=code95
POSTGRES_USER=
POSTGRES_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=

# CORS — frontend runs on :4200 with nx serve
FRONTEND_URL=http://localhost:4200

PORT=3000

MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ecard-files
MINIO_PUBLIC_URL=http://localhost:9000

# Grafana alerting — webhook URL for alert notifications
GRAFANA_ALERT_WEBHOOK_URL=http://localhost:8080/alert
